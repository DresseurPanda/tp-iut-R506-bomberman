[gd_scene format=3]

[ext_resource type="Script" path="res://Menu/menu.gd" id="1_menu"]

[node name="Menu" type="ColorRect"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0454818, 0.057526425, 0.073315926, 1)
script = ExtResource("1_menu")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Titre" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 100
text = "Bomberman"
horizontal_alignment = 1

[node name="UnJoueur" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 70)
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "1 joueur"

[node name="DeuxJoueurs" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 70)
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "2 joueurs"

[node name="Quitter" type="Button" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 70)
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "Quitter"

[node name="Commandes" type="HBoxContainer" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 120
alignment = 1

[node name="Joueur1" type="Label" parent="CenterContainer/VBoxContainer/Commandes"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Joueur 1
Déplacement : flèches
Bombe : Entrée"
horizontal_alignment = 1

[node name="Joueur2" type="Label" parent="CenterContainer/VBoxContainer/Commandes"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Joueur 2
Déplacement : Z Q S D
Bombe : Espace"
horizontal_alignment = 1

[connection signal="pressed" from="CenterContainer/VBoxContainer/UnJoueur" to="." method="_on_un_joueur_pressed"]
[connection signal="pressed" from="CenterContainer/VBoxContainer/DeuxJoueurs" to="." method="_on_deux_joueurs_pressed"]
[connection signal="pressed" from="CenterContainer/VBoxContainer/Quitter" to="." method="_on_quitter_pressed"]
